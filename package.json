    "ecmarkup": "^25.0.3",
    "jsdom": "^29.1.1",
    "parse5-html-rewriting-stream": "^8.0.1",
    "tmp": "^0.2.7"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
